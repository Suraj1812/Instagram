# Copy this file to .env and fill in your own Supabase project's values.
# Project Settings -> API in your Supabase dashboard has both.
# These are safe to ship in the client bundle (Row Level Security is what
# actually protects your data, not keeping the anon key secret).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
